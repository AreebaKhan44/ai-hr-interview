DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Default: SQLite, zero setup, completely free — recommended for running
# this project easily. Set to False only if you specifically want PostgreSQL
# (then also fill in the DB_* values below and uncomment psycopg2-binary in
# requirements.txt).
USE_SQLITE=True

DB_NAME=hr_interview_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Fully OPTIONAL — leave this empty (the default). Every AI feature in this
# project (question generation, resume parsing, answer scoring, interview
# ranking) already works for free with no API key using built-in rule-based
# logic. Only set this if you specifically want to plug in a paid OpenAI
# model instead — then also uncomment "openai" in requirements.txt.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Feature 17: how many days a candidate's secure interview link stays valid.
INTERVIEW_LINK_EXPIRY_DAYS=7
